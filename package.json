{
  "name": "harness-manager",
  "version": "2.0.6",
  "description": "Claude Code와 Codex 로컬 환경을 관리하는 로컬 전용 데스크톱 앱",
  "main": "out/main/index.js",
  "private": true,
  "author": "uiop3847",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "icon": "node scripts/generate-icon.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "hm": "node out/main/cli.js"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "dompurify": "^3.2.3",
    "electron-updater": "^6.8.9",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.18.0",
    "marked": "^15.0.0",
    "motion": "^13.4.4",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.7.0",
    "vanilla-jsoneditor": "^3.12.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.6"
  },
  "build": {
    "appId": "com.digitrack.claudeharnessmanager",
    "productName": "Harness Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "artifactName": "Harness-Manager-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Harness Manager"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "Harness-Manager-${version}-${arch}.${ext}",
      "synopsis": "Claude Code와 Codex 로컬 환경 관리 데스크톱 앱"
    },
    "publish": {
      "provider": "github",
      "owner": "rafaam11",
      "repo": "harness-manager"
    }
  }
}
